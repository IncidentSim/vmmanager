[Unit]
Description=Isolated Firecracker builder VMM (%i)
Requires=firecracker-builder-network.service
After=firecracker-builder-network.service
ConditionPathExists=/dev/kvm
StartLimitIntervalSec=0

[Service]
Type=exec

User=root
Group=@CLIENT_GROUP@
UMask=0007
RootDirectory=/var/lib/firecracker-builder/jail
MountAPIVFS=no
WorkingDirectory=/work
RuntimeDirectory=firecracker-builder
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
BindReadOnlyPaths=/opt/firecracker-builder/firecracker:/bin/firecracker
BindReadOnlyPaths=/opt/firecracker-builder/vmlinux:/kernel/vmlinux
BindReadOnlyPaths=/usr/local/libexec/firecracker-builder-launcher
BindPaths=/var/lib/firecracker-builder/work:/work
BindPaths=/run/firecracker-builder:/run/firecracker-builder
BindPaths=/dev/kvm /dev/net/tun
ExecStart=/usr/local/libexec/firecracker-builder-launcher
ExecStopPost=/usr/local/libexec/firecracker-builder-launcher record-exit
Restart=always
RestartSec=1
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/proc:ro /sys:ro
InaccessiblePaths=/proc /sys
ReadWritePaths=/work /run/firecracker-builder
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=2G
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
