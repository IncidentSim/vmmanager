# Systemd USER unit for the HTTP frontend, installed by `vmhost install` (never enabled).
# Enable it only after the explicit handoff documented in
# docs/bot-api-client.md. Never run it alongside the legacy Telegram poller.
# This template intentionally does NOT replace the old binary/config/unit paths.
[Unit]
Description=vmbot HTTP-only Telegram frontend
After=network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/vmbot -config %h/.config/vmbot-http/vmbot.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
MemoryMax=256M
TasksMax=64
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=55s

[Install]
WantedBy=default.target
