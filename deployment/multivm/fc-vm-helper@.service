# PROPOSED (source only): one instance per accepted connection of fc-vm-helper.socket.
# The connection is stdin/stdout. cmd/vm-helper serves exactly one validated
# "start-slot N" line and starts only an idle firecracker-vm@N.service.
[Unit]
Description=Handle one start-slot request

[Service]
User=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/local/libexec/fc-vm-helper
RuntimeMaxSec=90
MemoryMax=32M
TasksMax=16
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
