{
  "backend": {
    "kind": "local",
    "local": {
      "work_root": "/var/lib/firecracker-vms/work",
      "images_dir": "/var/lib/firecracker-vms/images",
      "run_dir": "/run/firecracker-vms",
      "max_vms": 2,
      "helper": "/usr/local/libexec/fc-vm-helper-client",
      "ssh_user": "root",
      "min_free_mib": 1024,
      "profiles": [
        {"name": "small", "vcpu": 1, "mem_mib": 512, "disk_mib": 2048}
      ],
      "bastion": {"host": "bastion.example.com", "port": 22, "user": "jump"}
    }
  },
  "serve_facade": {
    "listen": "0.0.0.0:19450",
    "ca": "/etc/firecracker-vms/pki/facade-clients-ca.crt",
    "cert": "/etc/firecracker-vms/pki/facade-server.crt",
    "key": "/etc/firecracker-vms/pki/facade-server.key"
  }
}
