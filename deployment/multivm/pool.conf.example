# Install as /etc/firecracker-vms/pool.conf (root:root 0644). Shared, by value,
# by the network script, the helper and vmapi (vmapi refuses to start on a mismatch).
#
# GUEST_PREFIX is YOURS to choose: slot N uses PREFIX.N.0/30 (guest PREFIX.N.2).
# Pick a range that overlaps nothing on this host. The network script re-checks
# every route and interface address at start and refuses on any overlap. Do not
# use Docker's 172.17/16, the legacy 172.16.0.0/30, or any range your LAN/VPN uses.
# The value below is a placeholder, not a recommendation for your network.
GUEST_PREFIX=10.213
MAX_SLOTS=2

# Optional operator-only public SSH publication (disabled unless BOTH uncommented).
# Replace 8.8.4.4 with the actual IPv4 assigned to the one default uplink.
# PUBLIC_IPV4=8.8.4.4
# SSH_PORT_BASE=22000
# Slot N: PUBLIC_IPV4:(SSH_PORT_BASE+N) -> GUEST_PREFIX.N.2:22 (TCP only).
# Reserve the whole port range; see ../NETWORK.md (four-slot) or NETWORK.md.
