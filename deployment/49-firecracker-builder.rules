// Only this one existing root-owned service, only lifecycle operations.
// This does not grant manage-unit-files, daemon-reload, other units or sudo.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "@CLIENT_USER@" &&
        action.lookup("unit") === "firecracker-builder@main.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) !== -1) {
        return polkit.Result.YES;
    }
});
