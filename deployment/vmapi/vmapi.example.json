{
  "listen_addr": "127.0.0.1:8090",
  "state_dir": "/home/USER/.local/state/vmapi",
  "allowed_user_ids": [123456789],
  "legacy_owner_user_id": 123456789,
  "shared_image_ids": ["base-image-id"],
  "max_vms": 2,
  "max_vms_per_user": 1,
  "default_profile": "small",
  "credentials": [
    {"token_file": "/home/USER/.config/vmapi/service-token", "service": true},
    {"token_file": "/home/USER/.config/vmapi/user-123456789-token", "user_id": 123456789}
  ],
  "facade": {
    "addr": "vmd.example.com:19450",
    "server_name": "vmd.example.com",
    "ca_file": "/home/USER/.config/vmapi/pki/facade-ca.crt",
    "cert_file": "/home/USER/.config/vmapi/pki/vmapi-client.crt",
    "key_file": "/home/USER/.config/vmapi/pki/vmapi-client.key"
  },
  "terminal": {
    "listen_addr": "0.0.0.0:8443",
    "public_origin": "https://bot.example.com:8443",
    "tls_cert_file": "/path/to/your/fullchain.pem",
    "tls_key_file": "/path/to/your/privkey.pem",
    "ttyd_path": "ttyd",
    "ssh_path": "ssh",
    "ssh_key_file": "/home/USER/.config/vmapi/guest-ssh-key",
    "ssh_use_bastion": false,
    "max_clients": 2
  }
}
