# PROPOSED template (source only). Install only after operator review/approval.
# One VMM process per slot N (firecracker-vm@N.service), separate from the active
# legacy firecracker-builder@main.service: different unit, runtime dir, jail, TAP
# prefix (tap-vmN) and operator-chosen guest pool (/etc/firecracker-vms/pool.conf).
# Replace @CLIENT_GROUP@ with the unprivileged vmd user's primary group.
#
# Networking is NOT done here. RootDirectory= applies to every Exec* line of this
# unit (a "+" prefix is not relied on), so the jail deliberately contains no
# shell/ip/iptables. TAP/NAT is a separate host-root oneshot dependency,
# firecracker-vm-network@%i.service, started via Requires= and stopped after this
# unit (After= reverses on shutdown), i.e. after ExecStopPost has written the
# exit receipt.
#
# Instances share the legacy aggregate budget slice, so 2 GiB / 1 CPU is shared with
# the legacy VMM instead of multiplied. See deployment/resources.md.
[Unit]
Description=Isolated Firecracker VMM for VM slot %i
Requires=firecracker-vm-network@%i.service
After=firecracker-vm-network@%i.service
# Assert* (not Condition*) so a missing prerequisite FAILS the start instead of silently skipping it.
AssertPathExists=/dev/kvm
RequiresMountsFor=/var/lib/firecracker-builder/storage
AssertPathIsMountPoint=/var/lib/firecracker-builder/storage
AssertPathIsDirectory=/var/lib/firecracker-builder/storage/vms/work
StartLimitIntervalSec=0

[Service]
Type=exec
Slice=system-firecracker\x2dbuilder.slice
User=root
Group=@CLIENT_GROUP@
UMask=0007
RootDirectory=/var/lib/firecracker-vms/jail
MountAPIVFS=no
WorkingDirectory=/work
RuntimeDirectory=firecracker-vms/slot-%i
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=/opt/firecracker-builder/firecracker:/bin/firecracker
BindReadOnlyPaths=/opt/firecracker-builder/vmlinux:/kernel/vmlinux
BindReadOnlyPaths=/usr/local/libexec/fc-vm-launcher
BindPaths=/var/lib/firecracker-builder/storage/vms/work:/work
BindPaths=/run/firecracker-vms/slot-%i:/run/slot
BindPaths=/dev/kvm /dev/net/tun
ExecStart=/usr/local/libexec/fc-vm-launcher run %i
ExecStopPost=/usr/local/libexec/fc-vm-launcher record-exit %i
# A guest reboot/exit ends the VMM; the slot stays idle until the helper starts it again.
Restart=no
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/proc:ro /sys:ro
InaccessiblePaths=/proc /sys
ReadWritePaths=/work /run/slot
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Per-instance cap (guest RAM + VMM overhead); keep >= profile mem + vmm_overhead_mib.
MemoryMax=768M
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
