# Source-only systemd USER template for the NEW HTTP frontend.
# Install as vmbot-http.service only after the explicit handoff documented in
# docs/bot-api-client.md. Never run it alongside the legacy Telegram poller.
# This template intentionally does NOT replace the old binary/config/unit paths.
[Unit]
Description=vmbot HTTP-only Telegram frontend
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vmbot-http -config %h/.config/vmbot-http/vmbot.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
MemoryMax=256M
TasksMax=64
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=55s

[Install]
WantedBy=default.target
