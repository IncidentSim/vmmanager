{
  "listen_addr": "127.0.0.1:8090",
  "state_dir": "/home/USER/.local/state/vmapi",
  "allowed_usernames": ["@example_user_one", "example_user_two"],
  "admin_user_ids": [],
  "allowed_user_ids": [],
  "legacy_owner_user_id": 0,
  "jwt": {
    "public_key_file": "/home/USER/.config/vmapi/jwt-public.pem",
    "issuer": "incident-sim-bot",
    "audience": "incident-sim-api"
  },
  "credentials": [],
  "expose_api_on_terminal": true,
  "shared_image_ids": ["base-image-id"],
  "max_vms": 2,
  "max_vms_per_user": 1,
  "default_profile": "small",
  "backend": {
    "work_root": "/var/lib/firecracker-builder/storage/vms/work",
    "images_dir": "/var/lib/firecracker-builder/storage/vms/images",
    "run_dir": "/run/firecracker-vms",
    "storage_mount": "/var/lib/firecracker-builder/storage",
    "max_vms": 2,
    "helper": "/usr/local/libexec/fc-vm-helper-client",
    "pool_conf": "/etc/firecracker-vms/pool.conf",
    "guest_prefix": "10.213",
    "guest_dns": ["1.1.1.1"],
    "ssh_user": "root",
    "min_free_mib": 1024,
    "max_total_mem_mib": 1024,
    "max_total_vcpu": 2,
    "unit_mem_limit_mib": 768,
    "vmm_overhead_mib": 64,
    "profiles": [
      {"name": "small", "vcpu": 1, "mem_mib": 512, "disk_mib": 2048}
    ],
    "bastion": {"host": "bastion.example.com", "port": 22, "user": "jump"}
  },
  "terminal": {
    "listen_addr": "0.0.0.0:8443",
    "public_origin": "https://bot.example.com:8443",
    "tls_cert_file": "/path/to/your/fullchain.pem",
    "tls_key_file": "/path/to/your/privkey.pem",
    "ttyd_path": "ttyd",
    "ssh_path": "ssh",
    "ssh_key_file": "/home/USER/.config/vmapi/guest-ssh-key",
    "ssh_use_bastion": false,
    "max_clients": 2
  }
}
