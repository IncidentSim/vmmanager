# PROPOSED (source only): the authorization boundary for the ONLY privileged
# request, "start-slot N". Only members of @CLIENT_GROUP@ can connect; there is no
# sudoers/polkit rule and no blanket systemctl right. Replace @CLIENT_GROUP@ with
# the unprivileged vmapi user's primary group (a dedicated group is better).
[Unit]
Description=Narrow start-slot socket for Firecracker VM slots

[Socket]
ListenStream=/run/fc-vm-helper.sock
SocketUser=root
SocketGroup=@CLIENT_GROUP@
SocketMode=0660
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
